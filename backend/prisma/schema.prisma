// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String?
  googleId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  UserProfile?
  messages Message[]
  threads  ChatParticipant[]
}

model UserProfile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  avatarUrl   String?
  name        String
  displayName String?
  phone       String?
  country     String?
  username    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

// schema design for messages and chat room
// So for two users to chat there will be a chatroom, that chat room will have messages in and a chatroom will
// have participants associated with it 

model ChatThread {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  isGroup Boolean @default(false)
  name    String?
  adminId String? @db.ObjectId

  participants ChatParticipant[] // a many to many field with users model

  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())

  isRead    Boolean  @default(false)
  readBy    String[] @default([])

  senderId String @db.ObjectId
  sender   User   @relation(fields: [senderId], references: [id])

  threadId String     @db.ObjectId
  thread   ChatThread @relation(fields: [threadId], references: [id])
}

//many to many connection of chatthread and users

model ChatParticipant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  threadId String     @db.ObjectId
  thread   ChatThread @relation(fields: [threadId], references: [id])

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, threadId])
}
