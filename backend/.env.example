# DotChat Backend Environment Variables Template

# Server Port (Defaults to 8080)
PORT=8080

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas or self-hosted)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/dotchat?retryWrites=true&w=majority"

# JWT Secret Key for user authentication tokens
JWT_SECRET_KEY="replace_with_a_secure_random_secret_key"

# Client Frontend URL(s) for CORS (supports single or comma-separated URLs)
# Example for production: https://dotchat.vercel.app,https://dotchat.com
CLIENT_URL="http://localhost:3000"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
