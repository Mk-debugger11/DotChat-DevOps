# DotChat Frontend Environment Variables Template

# Backend REST API URL (No trailing slash)
# Example for production: https://dotchat-api.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:8080"

# Backend Socket.IO WebSocket URL (Defaults to NEXT_PUBLIC_API_URL if omitted)
# Example for production: https://dotchat-api.onrender.com
NEXT_PUBLIC_SOCKET_URL="http://localhost:8080"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
